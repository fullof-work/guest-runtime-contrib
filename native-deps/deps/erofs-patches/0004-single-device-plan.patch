+// SPDX-License-Identifier: GPL-2.0+ OR Apache-2.0
+/* Single-device directory plans retain the native layout and 4 KiB SHA-256
+ * deduplication. The chunk blob is represented by ordered source references. */
+#define _GNU_SOURCE
+#include "erofs/plan.h"
+#include "erofs/print.h"
+#include "sha256.h"
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define PLAN_HEADER_SIZE 192
+#define PLAN_SOURCE_SIZE 80
+#define PLAN_RECORD_SIZE 64
+#define PLAN_FEATURES 1 /* single device, uncompressed, full SHA-256, 4 KiB */
+
+static struct {
+	bool enabled;
+	int header, chunks, sources;
+	u64 byte_limit, source_count, chunk_count, source_bytes;
+	u64 data_offset, data_length;
+	struct stat source_stat;
+	u8 chunk_buffer[65536];
+	size_t chunk_used;
+} plan = { .header = -1, .chunks = -1, .sources = -1 };
+
+static void put32(u8 *p, u32 value)
+{
+	__le32 v = cpu_to_le32(value);
+	memcpy(p, &v, sizeof(v));
+}
+
+static void put64(u8 *p, u64 value)
+{
+	__le64 v = cpu_to_le64(value);
+	memcpy(p, &v, sizeof(v));
+}
+
+static int write_all(int fd, const void *buf, size_t len)
+{
+	const u8 *p = buf;
+	while (len) {
+		ssize_t n = write(fd, p, len);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			return n < 0 ? -errno : -EIO;
+		p += n;
+		len -= n;
+	}
+	return 0;
+}
+
+static int budget(u64 extra)
+{
+	u64 used = PLAN_HEADER_SIZE + plan.source_bytes + plan.chunk_count * PLAN_RECORD_SIZE;
+	if (used > plan.byte_limit || extra > plan.byte_limit - used) {
+		erofs_err("EROFS plan byte budget exceeded");
+		return -EFBIG;
+	}
+	return 0;
+}
+
+bool erofs_plan_enabled(void)
+{
+	return plan.enabled;
+}
+
+int erofs_plan_init(const char *path, u64 memory_limit, u64 byte_limit)
+{
+	struct rlimit limit;
+	u8 zero[PLAN_HEADER_SIZE] = {0};
+	char *name;
+	int ret;
+
+	if (memory_limit < (16ULL << 20) || memory_limit > INT64_MAX || byte_limit < PLAN_HEADER_SIZE ||
+	    byte_limit > INT64_MAX || strlen(path) > 4096)
+		return -EINVAL;
+	/* Bound the entire native address space, including the dedup hash table,
+	 * inode/path tables and importer buffers, not merely the read buffer. */
+	if (getrlimit(RLIMIT_AS, &limit))
+		return -errno;
+	if (limit.rlim_cur == RLIM_INFINITY || limit.rlim_cur > memory_limit)
+		limit.rlim_cur = memory_limit;
+	if (setrlimit(RLIMIT_AS, &limit))
+		return -errno;
+	plan.byte_limit = byte_limit;
+	plan.header = open(path, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	if (plan.header < 0)
+		return -errno;
+	ret = write_all(plan.header, zero, sizeof(zero));
+	if (ret)
+		return ret;
+	if (asprintf(&name, "%s.chunks", path) < 0)
+		return -ENOMEM;
+	plan.chunks = open(name, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	free(name);
+	if (plan.chunks < 0)
+		return -errno;
+	if (asprintf(&name, "%s.sources", path) < 0)
+		return -ENOMEM;
+	plan.sources = open(name, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	free(name);
+	if (plan.sources < 0)
+		return -errno;
+	plan.enabled = true;
+	return 0;
+}
+
+int erofs_plan_source(const char *path, int fd, u64 *id)
+{
+	u8 entry[PLAN_SOURCE_SIZE] = {0};
+	struct stat st;
+	const char *relative;
+	size_t len;
+	int ret;
+
+	if (!plan.enabled) {
+		*id = 0;
+		return 0;
+	}
+	if (fstat(fd, &st))
+		return -errno;
+	if (!S_ISREG(st.st_mode) || st.st_size < 0)
+		return -EINVAL;
+	relative = erofs_fspath(path);
+	while (*relative == '/')
+		++relative;
+	len = strlen(relative);
+	if (!len || len > 4096 || plan.source_count >= 1000000)
+		return -EFBIG;
+	ret = budget(sizeof(entry) + len);
+	if (ret)
+		return ret;
+	*id = ++plan.source_count;
+	put64(entry, *id);
+	put64(entry + 8, st.st_dev);
+	put64(entry + 16, st.st_ino);
+	put64(entry + 24, st.st_size);
+	put64(entry + 32, st.st_mtim.tv_sec);
+	put64(entry + 40, st.st_ctim.tv_sec);
+	put32(entry + 48, st.st_mtim.tv_nsec);
+	put32(entry + 52, st.st_ctim.tv_nsec);
+	put32(entry + 56, st.st_mode);
+	put32(entry + 60, st.st_uid);
+	put32(entry + 64, st.st_gid);
+	put32(entry + 68, len);
+	put64(entry + 72, st.st_nlink);
+	ret = write_all(plan.sources, entry, sizeof(entry));
+	if (!ret)
+		ret = write_all(plan.sources, relative, len);
+	if (ret)
+		return ret;
+	plan.source_stat = st;
+	plan.source_bytes += sizeof(entry) + len;
+	return 0;
+}
+
+int erofs_plan_check_source(int fd, u64 id)
+{
+	struct stat st, *before = &plan.source_stat;
+	if (!plan.enabled)
+		return 0;
+	if (fstat(fd, &st))
+		return -errno;
+	/* atime is intentionally absent: reading must not invalidate a source. */
+	if (id != plan.source_count || st.st_dev != before->st_dev ||
+	    st.st_ino != before->st_ino || st.st_size != before->st_size ||
+	    st.st_mode != before->st_mode || st.st_uid != before->st_uid ||
+	    st.st_gid != before->st_gid || st.st_nlink != before->st_nlink ||
+	    st.st_mtim.tv_sec != before->st_mtim.tv_sec ||
+	    st.st_mtim.tv_nsec != before->st_mtim.tv_nsec ||
+	    st.st_ctim.tv_sec != before->st_ctim.tv_sec ||
+	    st.st_ctim.tv_nsec != before->st_ctim.tv_nsec) {
+		erofs_err("EROFS plan source changed during hashing");
+		return -ESTALE;
+	}
+	return 0;
+}
+
+int erofs_plan_chunk(u64 dst, u64 src, u32 len, u64 id, const u8 digest[32])
+{
+	u8 record[PLAN_RECORD_SIZE];
+	int ret = budget(sizeof(record));
+	if (ret)
+		return ret;
+	if (plan.chunk_count >= INT64_MAX / 4096 || !len || len > 4096 || id != plan.source_count ||
+	    dst != plan.chunk_count * 4096 || src > plan.source_stat.st_size ||
+	    len > plan.source_stat.st_size - src)
+		return -EINVAL;
+	put64(record, dst);
+	put64(record + 8, src);
+	put64(record + 16, id);
+	put32(record + 24, len);
+	put32(record + 28, 4096 - len);
+	memcpy(record + 32, digest, 32);
+	if (plan.chunk_used + sizeof(record) > sizeof(plan.chunk_buffer)) {
+		ret = write_all(plan.chunks, plan.chunk_buffer, plan.chunk_used);
+		if (ret)
+			return ret;
+		plan.chunk_used = 0;
+	}
+	memcpy(plan.chunk_buffer + plan.chunk_used, record, sizeof(record));
+	plan.chunk_used += sizeof(record);
+	++plan.chunk_count;
+	return 0;
+}
+
+void erofs_plan_data(u64 offset, u64 length)
+{
+	plan.data_offset = offset;
+	plan.data_length = length;
+}
+
+static int hash_range(struct sha256_state *md, int fd, u64 off, u64 len)
+{
+	u8 buf[65536];
+	while (len) {
+		size_t want = min_t(u64, sizeof(buf), len), done = 0;
+		while (done < want) {
+			ssize_t n = pread(fd, buf + done, want - done, off + done);
+			if (n < 0 && errno == EINTR)
+				continue;
+			if (n <= 0)
+				return n < 0 ? -errno : -EIO;
+			done += n;
+		}
+		erofs_sha256_process(md, buf, want);
+		off += want;
+		len -= want;
+	}
+	return 0;
+}
+
+static int digest_ranges(int fd, u64 first, u64 skip, u64 total, u8 digest[32])
+{
+	struct sha256_state md;
+	int ret;
+	erofs_sha256_init(&md);
+	ret = hash_range(&md, fd, 0, first);
+	if (!ret)
+		ret = hash_range(&md, fd, first + skip, total - first - skip);
+	/* Finalize even on error, releasing the static Libgcrypt context. */
+	erofs_sha256_done(&md, digest);
+	return ret;
+}
+
+int erofs_plan_finish(struct erofs_sb_info *sbi)
+{
+	u8 header[PLAN_HEADER_SIZE] = {0};
+	u64 logical;
+	int ret;
+
+	if (!plan.enabled)
+		return 0;
+	if (sbi->blkszbits != 12 || sbi->primarydevice_blocks > ((u64)INT64_MAX >> 12))
+		return -EOVERFLOW;
+	logical = sbi->primarydevice_blocks << 12;
+	ret = write_all(plan.chunks, plan.chunk_buffer, plan.chunk_used);
+	if (ret)
+		return ret;
+	plan.chunk_used = 0;
+	if (plan.data_offset > logical || plan.data_length > logical - plan.data_offset ||
+	    plan.data_length != plan.chunk_count * 4096)
+		return -EINVAL;
+	ret = budget(logical - plan.data_length);
+	if (ret)
+		return ret;
+	memcpy(header, "KERPLAN\0", 8);
+	put32(header + 8, 1);
+	put32(header + 12, sizeof(header));
+	put64(header + 16, PLAN_FEATURES);
+	put64(header + 24, logical);
+	put64(header + 32, plan.data_offset);
+	put64(header + 40, plan.data_length);
+	put64(header + 48, plan.chunk_count);
+	put64(header + 56, plan.source_count);
+	put64(header + 64, plan.chunk_count * PLAN_RECORD_SIZE);
+	put64(header + 72, plan.source_bytes);
+	ret = digest_ranges(sbi->bdev.fd, plan.data_offset, plan.data_length, logical, header + 80);
+	if (!ret)
+		ret = digest_ranges(plan.chunks, plan.chunk_count * PLAN_RECORD_SIZE, 0,
+				    plan.chunk_count * PLAN_RECORD_SIZE, header + 112);
+	if (!ret)
+		ret = digest_ranges(plan.sources, plan.source_bytes, 0, plan.source_bytes, header + 144);
+	if (ret)
+		return ret;
+	if (close(plan.chunks))
+		ret = -errno;
+	plan.chunks = -1;
+	if (close(plan.sources) && !ret)
+		ret = -errno;
+	plan.sources = -1;
+	if (ret)
+		return ret;
+	if (lseek(plan.header, 0, SEEK_SET) != 0)
+		return -errno;
+	ret = write_all(plan.header, header, sizeof(header));
+	if (close(plan.header) && !ret)
+		ret = -errno;
+	plan.header = -1;
+	return ret;
+}
+
+void erofs_plan_exit(void)
+{
+	if (plan.header >= 0)
+		close(plan.header);
+	if (plan.chunks >= 0)
+		close(plan.chunks);
+	if (plan.sources >= 0)
+		close(plan.sources);
+}
