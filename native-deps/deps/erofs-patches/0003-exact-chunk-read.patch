--- a/lib/blobchunk.c
+++ b/lib/blobchunk.c
@@ -404,10 +404,19 @@
 		}
 
 		len = min_t(u64, inode->i_size - pos, chunksize);
-		ret = read(fd, chunkdata, len);
-		if (ret < len) {
-			ret = -EIO;
-			goto err;
+		/* Check signed results before comparing with the chunk length. */
+		{
+			size_t done = 0;
+			while (done < len) {
+				ssize_t nread = read(fd, chunkdata + done, len - done);
+				if (nread < 0 && errno == EINTR)
+					continue;
+				if (nread <= 0) {
+					ret = nread < 0 ? -errno : -EIO;
+					goto err;
+				}
+				done += nread;
+			}
 		}
 
 		chunk = erofs_blob_getchunk(sbi, chunkdata, len);
